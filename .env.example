# Copy to .env (`make init` does it and generates BETTER_AUTH_SECRET).
# Coolify: same names in the app's Environment tab (see DEPLOY.md).

# --- Local Postgres (docker-compose.yml) ---
COMPOSE_PROJECT_NAME=tanstack-template
POSTGRES_USER=app
POSTGRES_PASSWORD=app
POSTGRES_DB=app
POSTGRES_PORT=5434

# --- App ---
DATABASE_URL=postgres://app:app@localhost:5434/app
DATABASE_POOL_MAX=10
APP_URL=http://localhost:3000
# Comma-separated extra origins (optional).
TRUSTED_ORIGINS=
# Required. openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- Storage: R2 when every CF_* is set, else STORAGE_DIR on disk ---
STORAGE_DIR=./storage
CF_ENDPOINT=
CF_ACCESS_KEY_ID=
CF_ACCESS_SECRET=
CF_BUCKET=

# --- E-mail: Resend → Mailpit → {STORAGE_DIR}/_outbox ---
RESEND_API_KEY=
MAILPIT_URL=http://localhost:8025
EMAIL_FROM=App <no-reply@example.com>
EMAIL_REPLY_TO=

# --- Turnstile: blank outside production → Cloudflare test keys ---
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Sentry: runtime DSN; VITE_SENTRY_DSN, SENTRY_AUTH_TOKEN, SENTRY_PROJECT are build args ---
SENTRY_DSN=
VITE_SENTRY_DSN=
SENTRY_PROJECT=

# --- OpenPanel (self-hosted). Blank client id → no analytics ---
OPENPANEL_API_URL=https://o.mystudio.digital/api
OPENPANEL_CLIENT_ID=

# --- Cloudflare edge cache: production purges the public pages after each deploy ---
# Zone of APP_URL and a token limited to « Zone › Cache Purge » on it. Blank: no purge.
CLOUDFLARE_ZONE_ID=
CLOUDFLARE_API_TOKEN=
